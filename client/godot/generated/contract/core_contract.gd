	var template_id: int = 0
	var args: Array[MailArg] = []
	var attachments: Array[ItemAmount] = []
	var extra_id: int = 0
	var sent_at: int = 0
	var expires_at: int = 0
	var read: bool = false


	func encode() -> PackedByteArray:
		var out: PackedByteArray = PackedByteArray()
		_put_int64(out, 1, id)
		_put_int32(out, 2, template_id)
		for item: MailArg in args:
			_put_message_item(out, 3, item)
		for item: ItemAmount in attachments:
			_put_message_item(out, 4, item)
		_put_int32(out, 5, extra_id)
		_put_int64(out, 6, sent_at)
		_put_int64(out, 7, expires_at)
		_put_bool(out, 8, read)
		return out


	func decode(_bytes: PackedByteArray) -> bool:
		_reset()
		return _merge(_bytes)


	func copy_from(_source: ContractMessage) -> void:
		if not (_source is MailUserState):
			return
		var other: MailUserState = _source as MailUserState
		id = other.id
		template_id = other.template_id
		args = other.args
		attachments = other.attachments
		extra_id = other.extra_id
		sent_at = other.sent_at
		expires_at = other.expires_at
		read = other.read


	func _reset() -> void:
		id = 0
		template_id = 0
		args = []
		attachments = []
		extra_id = 0
		sent_at = 0
		expires_at = 0
		read = false


	func _merge(_bytes: PackedByteArray) -> bool:
		var reader: ContractMessage._WireReader = ContractMessage._WireReader.new(_bytes)
		while reader.more():
			var tag: int = reader.tag()
			var wire: int = tag & 7
			match tag >> 3:
				1:
					id = reader.int64(wire)
				2:
					template_id = reader.int32(wire)
				3:
					var item: MailArg = MailArg.new()
					if not _merge_child(item, reader.bytes(wire)):
						return false
					args.append(item)
				4:
					var item: ItemAmount = ItemAmount.new()
					if not _merge_child(item, reader.bytes(wire)):
						return false
					attachments.append(item)
				5:
					extra_id = reader.int32(wire)
				6:
					sent_at = reader.int64(wire)
				7:
					expires_at = reader.int64(wire)
				8:
					read = reader.boolean(wire)
				_:
					reader.skip(wire)
		return not reader.failed


