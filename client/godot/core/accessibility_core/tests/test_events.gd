extends "res://core/accessibility_core/tests/support/accessibility_test_case.gd"
## `AccessibilityChangedEvent`: one per `set_*` that changed a value, none for the same value.


func test_each_set_that_changes_a_value_publishes_one_event_and_the_same_value_none() -> void:
	assert_true(await start_modules())
	AccessibilityCore.apply_saved_settings()
	count_changes()
	assert_true(AccessibilityCore.set_text_scale(1250))
	assert_eq(changes, 1, "set_text_scale")
	assert_true(AccessibilityCore.set_text_scale(1250))
	assert_eq(changes, 1, "set_text_scale with the same value")
	assert_true(AccessibilityCore.set_color_mode(PROTANOPIA))
	assert_eq(changes, 2, "set_color_mode")
	assert_true(AccessibilityCore.set_color_mode(PROTANOPIA))
	assert_eq(changes, 2, "set_color_mode with the same value")
	AccessibilityCore.set_subtitles(false)
	assert_eq(changes, 3, "set_subtitles")
	AccessibilityCore.set_subtitles(false)
	assert_eq(changes, 3, "set_subtitles with the same value")
	AccessibilityCore.set_reduce_shake(true)
	assert_eq(changes, 4, "set_reduce_shake")
	AccessibilityCore.set_reduce_shake(true)
	assert_eq(changes, 4, "set_reduce_shake with the same value")
	AccessibilityCore.set_reduce_flash(true)
	assert_eq(changes, 5, "set_reduce_flash")
	AccessibilityCore.set_reduce_flash(true)
	assert_eq(changes, 5, "set_reduce_flash with the same value")
	assert_false(AccessibilityCore.set_text_scale(1100))
	assert_false(AccessibilityCore.set_color_mode(9 as AccessibilityCore.ColorMode))
	assert_eq(changes, 5, "a failed set")
	assert_eq(errors(), 2)
	AccessibilityCoreDev.set_test_text_scale(1500)
	AccessibilityCore.apply_saved_settings()
	assert_eq(changes, 5, "set_test_text_scale and apply_saved_settings")
