extends "res://core/badge_core/tests/support/badge_test_case.gd"
## Lifecycle: init check, release, init again, operations outside init and destruction of the core node.


func test_is_initialized_before_init_after_init_and_after_release() -> void:
	assert_true(await start_modules(false))
	assert_false(BadgeCore.is_initialized())
	assert_true(BadgeCore.init())
	assert_true(BadgeCore.is_initialized())
	BadgeCore.release()
	assert_false(BadgeCore.is_initialized())


func test_release_puts_static_vars_back_and_takes_core_node_out_of_tree() -> void:
	set_int("BadgeCore.refreshIntervalMs", 1000)
	set_string("BadgeCore.dotResource", DOT)
	assert_true(await start_saving())
	assert_true(await BadgeCore.prepare())
	assert_true(BadgeCore.register_evaluator(a_badge, Hooks.evaluate))
	assert_true(BadgeCore.set_item(saved_badge, 5, 1))
	var view: BadgeView = make_view()
	assert_true(view.bind(saved_badge))
	await frame_end()
	var display: Control = view._display
	assert_true(is_instance_valid(display))
	assert_true(BadgeCore.set_count(b_badge, 1))
	var node: Node = BadgeCore._node
	assert_true(node.is_inside_tree())
	BadgeCore.release()
	assert_false(node.is_inside_tree())
	assert_eq(EventCore.count_subscriptions(node), 0)
	assert_false(is_instance_valid(display), "the display is destroyed")
	assert_false(view._bound)
	assert_false(BadgeCore._is_initialized)
	assert_null(BadgeCore._session)
	assert_null(BadgeCore._node)
	assert_eq(BadgeCore._refresh_interval_ms, 0)
	assert_eq(BadgeCore._max_display_count, 0)
	assert_eq(BadgeCore._dot_resource, "")
	assert_true(BadgeCore._settings_ok)
	assert_eq(BadgeCore._badges.size(), 0)
	assert_eq(BadgeCore._order.size(), 0)
	assert_false(BadgeCore._tree_made)
	assert_false(BadgeCore._evaluate_all)
	assert_false(BadgeCore._judge_all)
	assert_eq(BadgeCore._touched.size(), 0)
	assert_false(BadgeCore._save_pending)
	assert_false(BadgeCore._saving)
	assert_false(BadgeCore._frame_end_queued)
	assert_true(BadgeCore._frame_end.is_null())
	assert_eq(BadgeCore._next_refresh_at, 0)
	assert_eq(BadgeCore._view_ids.size(), 0)
	assert_null(BadgeCore._dot_prefab)
	assert_null(BadgeCore._format_args)
	assert_eq(saved_items(), PackedStringArray([element(saved_badge, 5, 1)]), "saved values stay")
	await frame_end()
	assert_eq(events.size(), 2, "no frame end of the released session")
	free_view(view)


func test_operations_before_init_log_an_error_and_give_the_failure_value() -> void:
	assert_true(await start_modules(false))
	var view: BadgeView = make_view()
	assert_false(await BadgeCore.prepare())
	assert_false(BadgeCore.register_evaluator(a_badge, Hooks.evaluate))
	assert_false(BadgeCore.set_count(a_badge, 1))
	assert_false(BadgeCore.set_item(a_badge, 1, 1))
	BadgeCore.clear_item(a_badge, 1)
	BadgeCore.clear_items(a_badge)
	BadgeCore.refresh(a_badge)
	BadgeCore.refresh()
	assert_eq(BadgeCore.get_count(a_badge), 0)
	assert_eq(BadgeCore.get_item_count(a_badge, 1), 0)
	assert_false(BadgeCore.load_saved())
	assert_false(view.bind(a_badge))
	view.unbind()
	assert_eq(errors(), 13)
	assert_true(BadgeCore.init())
	assert_false(BadgeCore.init())
	assert_eq(errors(), 1)
	free_view(view)


func test_init_again_after_release_works_like_the_first_init() -> void:
	assert_true(await start_modules())
	assert_true(BadgeCore.set_count(a_badge, 2))
	assert_true(BadgeCore.register_evaluator(b_badge, Hooks.evaluate))
	await frame_end()
	BadgeCore.release()
	assert_true(BadgeCore.init())
	assert_eq(BadgeCore.get_count(a_badge), 0, "own counts are gone")
	assert_true(BadgeCore.register_evaluator(b_badge, Hooks.evaluate))
	assert_true(BadgeCore.set_count(a_badge, 1))
	await frame_end()
	assert_eq(BadgeCore.get_count(root_badge), 1)


func test_core_node_destroyed_outside_release_cleans_up_without_errors() -> void:
	assert_true(await start_modules())
	var view: BadgeView = make_view()
	assert_true(view.bind(a_badge))
	assert_true(BadgeCore.set_count(a_badge, 1))
	await frame_end()
	var node: Node = BadgeCore._node
	node.get_parent().remove_child(node)
	node.free()
	assert_false(BadgeCore.is_initialized())
	assert_false(view._bound)
	await UnitTestCore.wait_frames(1)
	free_view(view)
