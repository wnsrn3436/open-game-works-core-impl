func test_release_keeps_the_local_data_values() -> void:
	assert_true(await start_modules())
	SoundCore.set_volume(SoundCore.SoundBus.BGM, 0.25)
	SoundCore.release()
	var stored: float = LocalDataCore.get_value_float(LocalDataCore.FileKind.DEVICE, "SoundCore.bgm_volume", 1.0)
	assert_eq(stored, 0.25)


func test_init_after_release_has_no_bgm_no_pause_and_default_volumes() -> void:
	assert_true(await start_modules())
	await load_sound(BGM_A)
	await load_sound(BGM_B)
	SoundCore.play_bgm(BGM_A, scope)
	await wait_load_end(BGM_A)
	SoundCore.play_bgm(BGM_B, scope)
	await wait_load_end(BGM_B)
	SoundCore.set_volume(SoundCore.SoundBus.SFX, 0.5)
	SoundCore.request_pause()
	SoundCoreDev.inject_focus_change(false)
	SoundCore.release()
	assert_eq(SoundCore._players.size(), 0, "release leaves no player")
	assert_true(SoundCore.init())
	assert_eq(SoundCore.get_bgm_key(), "")
	assert_null(SoundCore._previous)
	assert_false(SoundCore._global_paused)
	for bus: int in SoundCore._BUS_NAMES.size():
		assert_eq(SoundCore.get_volume(bus as SoundCore.SoundBus), 1.0)
		assert_false(SoundCore.get_mute(bus as SoundCore.SoundBus))
	assert_true(SoundCore.is_haptic_enabled())


func test_core_node_freed_outside_release_cleans_up_without_errors() -> void:
	assert_true(await start_modules())
	await load_sound(LOOP_A)
	SoundCore.play(LOOP_A, SoundCore.SoundBus.SFX, scope)
	SoundCore.play_bgm(BGM_A)
	var node: Node = SoundCore._node
	node.free()
	assert_false(SoundCore.is_initialized())
	assert_null(SoundCore._node)
	assert_eq(SoundCore._owned_records.size(), 0)
	assert_eq(errors(), 0)
	assert_true(SoundCore.init())


func test_operations_before_init_log_an_error_and_return_failure_values() -> void:
	assert_true(await start_modules(false))
	SoundCore.load_volume_settings()
	SoundCore.set_volume(SoundCore.SoundBus.SFX, 0.5)
	assert_eq(SoundCore.get_volume(SoundCore.SoundBus.SFX), 1.0)
	SoundCore.set_mute(SoundCore.SoundBus.SFX, true)
	assert_false(SoundCore.get_mute(SoundCore.SoundBus.SFX))
	SoundCore.play_bgm(BGM_A, scope)
	SoundCore.stop_bgm()
	SoundCore.return_bgm()
	assert_eq(SoundCore.get_bgm_key(), "")
	assert_eq(SoundCore.play(SHORT, SoundCore.SoundBus.SFX, scope), SoundCore.INVALID_HANDLE)
	SoundCore.stop(1)
	assert_false(SoundCore.is_playing(1))
	assert_eq(SoundCore.request_pause(), SoundCore.INVALID_PAUSE_TOKEN)
	SoundCore.release_pause(1)
	assert_false(SoundCore.play_haptic(HAPTIC_VALID, scope))
	SoundCore.set_haptic_enabled(false)
	assert_false(SoundCore.is_haptic_enabled())
	assert_eq(errors(), 17)
	assert_true(SoundCore.init())
	assert_false(SoundCore.init())
	assert_eq(errors(), 1)
