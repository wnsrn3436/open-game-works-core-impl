func test_release_stops_prepare() -> void:
	assert_true(await start(true, false, false))
	var call: CALL = CALL.new()
	call.prepare()
	assert_false(call.done, "prepare waits for its loads")
	UICore.release()
	assert_true(call.done and not call.ok)


func test_release_stops_a_transition() -> void:
	assert_true(await start())
	var gate: GATE = LOG.add_gate(PANEL_A)
	var call: CALL = CALL.new()
	call.open_panel(PANEL_A)
	await UnitTestCore.wait_frames(3)
	UICore.release()
	assert_true(call.done and not call.ok)
	assert_eq(finished_events.size(), 0, "no event after release")
	assert_false(InputBlockCore.is_blocked())
	gate.open()


func test_init_again_works_like_the_first() -> void:
	assert_true(await start())
	assert_true(await UICore.open_panel(PANEL_A, null, false))
	UICore.release()
	assert_true(UICore.init())
	assert_true(await UICore.prepare())
	assert_true(await UICore.open_panel(PANEL_B, null, false))
	assert_eq(UICore.get_panel_stack(), PackedStringArray([PANEL_B]))
	assert_true(await UICore.open_popup(POPUP_A, null, Callable()) == UICore.PopupOpenResult.OPENED)


func test_core_node_destroyed_outside_release() -> void:
	assert_true(await start())
	assert_true(await UICore.open_panel(PANEL_A, null, false))
	assert_true(await UICore.open_popup(POPUP_A, null, Callable()) == UICore.PopupOpenResult.OPENED)
	var node: Node = UICore._node
	node.get_parent().remove_child(node)
	node.queue_free()
	assert_false(UICore.is_initialized())
	await UnitTestCore.wait_frames(2)
	assert_false(is_instance_valid(node))
	_assert_initial_statics()
