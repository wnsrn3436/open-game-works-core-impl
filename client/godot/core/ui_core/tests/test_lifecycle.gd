extends "res://core/ui_core/tests/support/ui_test_case.gd"
## Lifecycle: init check, release, init again and destruction of the core node outside release.


func test_is_initialized() -> void:
	assert_true(await start(false))
	assert_false(UICore.is_initialized())
	assert_true(UICore.init())
	assert_true(UICore.is_initialized())
	assert_false(UICore.init())
	assert_eq(errors(), 1)
	UICore.release()
	assert_false(UICore.is_initialized())


func test_release_removes_everything_without_callbacks() -> void:
	assert_true(await start())
	assert_true(await UICore.open_panel(PANEL_A, null, false))
	assert_true(await UICore.open_popup(POPUP_DIM_A, null, hidden_of("popup")) == UICore.PopupOpenResult.OPENED)
	assert_true(await UICore.open_system_popup(one_button_param("button"), hidden_of("system")))
	var gate: GATE = LOG.add_gate(POPUP_B)
	var waiting: CALL = CALL.new()
	waiting.open_popup(POPUP_B)
	var token: int = UICore.show_loading_icon()
	var node: Node = UICore._node
	var layers: Array[CanvasLayer] = UICore._layers.duplicate()
	var panel: UIPanel = current()
	var panel_scope: Scope = panel.scope
	LOG.entries = PackedStringArray()
	opened_events = PackedStringArray()
	closed_events = PackedStringArray()
	UICore.release()
	assert_true(waiting.done and waiting.result == UICore.PopupOpenResult.FAILED, "a stopped operation fails")
	assert_false(node.is_inside_tree())
	assert_true(panel_scope.released)
	assert_eq(LOG.count(PANEL_A + ":on_closed") + LOG.count(POPUP_DIM_A + ":on_closed"), 0, "no on_closed")
	assert_eq(hidden_calls.size() + after_calls.size(), 0, "no hidden or button callback")
	assert_eq(opened_events.size() + closed_events.size(), 0, "no event")
	await UnitTestCore.wait_frames(2)
	assert_false(is_instance_valid(node))
	assert_false(is_instance_valid(panel))
	for layer: CanvasLayer in layers:
		assert_false(is_instance_valid(layer), "UI layers are gone")
	assert_false(InputBlockCore.is_blocked())
	_assert_initial_statics()
	gate.open()
	UICore.hide_loading_icon(token)
	assert_eq(errors(), 1, "hide_loading_icon after release")


