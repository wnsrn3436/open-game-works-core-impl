func test_pass_list_lets_only_the_system_popup_through() -> void:
	assert_true(await start())
	assert_true(await UICore.open_panel(PANEL_NONMODAL, null, false))
	var panel_button: Button = named_button(current(), "Button")
	ui_button_of(panel_button).set_on_click(click_of("panel"))
	var token: int = InputBlockCore.block("content", UICore.get_block_pass_list())
	await tap_control(panel_button)
	assert_eq(clicks.size(), 0, "a position in the safe area does not pass")
	assert_true(await UICore.open_system_popup(one_button_param("system"), Callable()))
	await tap_control(system_buttons(system_popup())[0])
	assert_eq(after_calls, PackedStringArray(["system"]))
	InputBlockCore.unblock(token)


func test_block_pass_list_is_one_object() -> void:
	assert_true(await start())
	var first: BlockPassList = UICore.get_block_pass_list()
	assert_eq(UICore.get_block_pass_list(), first)
	assert_eq(first.elements.size(), 1)
	assert_eq(first.elements[0], UICore._system_root)
	assert_eq(first.actions, [&"back"] as Array[StringName])


func test_open_flow_block_released_by_release_all_is_not_unblocked_again() -> void:
	assert_true(await start())
	var gate: GATE = LOG.add_gate(POPUP_A)
	var cancelled: CALL = CALL.new()
	cancelled.open_popup(POPUP_A)
	await UnitTestCore.wait_frames(2)
	assert_true(InputBlockCore.is_blocked(), "during the popup open flow")
	assert_eq(InputBlockCore.release_all(), 1, "the open flow block")
	assert_eq(UnitTestCore.check_logs(WARN, "InputBlockCore"), 1, "the release_all warn")
	UICore.close_all_popups()
	assert_true(cancelled.done and cancelled.result == UICore.PopupOpenResult.FAILED)
	assert_eq(UnitTestCore.check_logs(ERROR, "InputBlockCore"), 0, "no unblock of the released token")
	gate.open()
	var gate_b: GATE = LOG.add_gate(POPUP_B)
	var opened: CALL = CALL.new()
	opened.open_popup(POPUP_B)
	await UnitTestCore.wait_frames(2)
	assert_eq(InputBlockCore.release_all(), 1)
	assert_eq(UnitTestCore.check_logs(WARN, "InputBlockCore"), 1)
	gate_b.open()
	await finish(opened)
	assert_true(opened.ok, "the open flow ends after its block was released")
	assert_eq(UnitTestCore.check_logs(ERROR, "InputBlockCore"), 0)
	assert_false(InputBlockCore.is_blocked())


func test_close_block_released_by_release_all_is_not_unblocked_again() -> void:
	assert_true(await start())
	var call: CALL = CALL.new()
	call.open_popup(POPUP_TWEEN, hidden_of("first"))
	await finish(call)
	var closing: CALL = CALL.new()
	closing.close_popup(popup_of(POPUP_TWEEN), after_of("after"))
	await UnitTestCore.wait_frames(1)
	assert_eq(InputBlockCore.release_all(), 1, "the close tween block")
	assert_eq(UnitTestCore.check_logs(WARN, "InputBlockCore"), 1)
	await finish(closing)
	assert_eq(after_calls, PackedStringArray(["after"]), "the close ends")
	assert_eq(UnitTestCore.check_logs(ERROR, "InputBlockCore"), 0)
	var again: CALL = CALL.new()
	again.open_popup(POPUP_TWEEN, hidden_of("second"))
	await finish(again)
	var closing_now: CALL = CALL.new()
	closing_now.close_popup(popup_of(POPUP_TWEEN))
	await UnitTestCore.wait_frames(1)
	assert_eq(InputBlockCore.release_all(), 1)
	assert_eq(UnitTestCore.check_logs(WARN, "InputBlockCore"), 1)
	UICore.close_all_popups()
	assert_eq(hidden_calls, PackedStringArray(["first", "second"]))
	assert_eq(UnitTestCore.check_logs(ERROR, "InputBlockCore"), 0)
	assert_false(InputBlockCore.is_blocked())
