extends "res://core/ui_core/tests/support/ui_test_case.gd"
## The `ui` block of panel transitions and popup flows, and the block pass list.


func test_ui_block_during_flows_and_none_after() -> void:
	assert_true(await start())
	var gate: GATE = LOG.add_gate(PANEL_A)
	var open: CALL = CALL.new()
	open.open_panel(PANEL_A)
	await UnitTestCore.wait_frames(2)
	assert_true(InputBlockCore.is_blocked(), "during a panel transition")
	gate.open()
	await finish(open)
	assert_true(open.ok)
	assert_false(InputBlockCore.is_blocked(), "after success")
	LOG.fail_new[PANEL_B] = true
	assert_false(await UICore.open_panel(PANEL_B, null, false))
	assert_false(InputBlockCore.is_blocked(), "after failure")
	var gate_c: GATE = LOG.add_gate(PANEL_C)
	var cancelled: CALL = CALL.new()
	cancelled.open_panel(PANEL_C)
	await UnitTestCore.wait_frames(2)
	UICore.reset_panel_stack()
	assert_false(InputBlockCore.is_blocked(), "after cancel")
	gate_c.open()
	var popup_gate: GATE = LOG.add_gate(POPUP_A)
	var popup: CALL = CALL.new()
	popup.open_popup(POPUP_A)
	await UnitTestCore.wait_frames(2)
	assert_true(InputBlockCore.is_blocked(), "during a popup open flow")
	popup_gate.open()
	await finish(popup)
	assert_false(InputBlockCore.is_blocked())
	var closing: CALL = CALL.new()
	closing.close_popup(popup_of(POPUP_A))
	await finish(closing)
	assert_false(InputBlockCore.is_blocked(), "after the close")


func test_ui_block_survives_a_long_retry_popup() -> void:
	assert_true(await start())
	var gate: GATE = LOG.add_gate(PANEL_A)
	var open: CALL = CALL.new()
	open.open_panel(PANEL_A)
	await UnitTestCore.wait_frames(2)
	# The retry popup a request of the panel prepare would open.
	assert_true(await UICore.open_system_popup(one_button_param("retry"), Callable()))
	await advance(MAX_BLOCK_MS + 1000)
	assert_true(InputBlockCore.is_blocked(), "no forced release while the system popup shows")
	assert_eq(UnitTestCore.check_logs(WARN, "InputBlockCore"), 0)
	await tap_control(system_buttons(system_popup())[0])
	gate.open()
	await finish(open)
	assert_true(open.ok)
	assert_false(InputBlockCore.is_blocked())


