extends "res://core/camera_core/tests/support/camera_test_case.gd"
## `init`, `release`, the core node and the operations before `init` and after `release`.


func test_lifecycle() -> void:
	assert_true(start(false))
	assert_false(CameraCore.is_initialized())
	assert_true(CameraCore.init())
	assert_true(CameraCore.is_initialized())
	assert_false(CameraCore.init())
	assert_eq(errors(), 1)
	var node: Node = CameraCore._node
	assert_true(node.is_inside_tree())
	assert_eq(node.process_mode, Node.PROCESS_MODE_ALWAYS)
	CameraCore.set_shake_scale(300)
	CameraCore.release()
	assert_false(CameraCore.is_initialized())
	assert_false(node.is_inside_tree())
	_assert_initial_state()
	assert_true(CameraCore.init())
	assert_true(CameraCore.is_initialized())


func test_release_drops_the_camera_and_init_again_attaches() -> void:
	assert_true(start())
	var camera: Camera2D = camera_2d()
	assert_true(CameraCore.attach_camera(camera))
	assert_true(follow(target_2d(Vector2(30, 0))))
	assert_true(CameraCore.set_bounds(Rect2(-5000, -5000, 10000, 10000)))
	CameraCore.set_shake_scale(200)
	CameraCore.shake(1.0)
	run_move(Vector3(100, 0, 0), 1000)
	run_zoom(2.0, 1000)
	await advance(100)
	CameraCore.release()
	assert_results([FAILED, FAILED])
	_assert_initial_state()
	assert_true(CameraCore.init())
	assert_eq(CameraCore._shake_scale, 1000, "release put the shake scale back")
	assert_false(CameraCore.has_camera())
	assert_true(CameraCore.attach_camera(camera))
	assert_true(CameraCore.has_camera())
	var result: CameraCore.CameraMoveResult = await CameraCore.move_to(Vector3(9, 9, 0), 0, LINEAR, GAME)
	assert_eq(result, COMPLETED)
	assert_eq(camera.global_position, Vector2(9, 9))


func test_release_during_a_preset_load_does_not_move_after_the_load() -> void:
	assert_true(start())
	var camera: Camera2D = camera_2d()
	assert_true(CameraCore.attach_camera(camera))
	run_preset(Vector3(300, 0, 0))
	CameraCore.release()
	assert_results([FAILED])
	await preset_loaded()
	await advance(MOVE_MS * 2)
	assert_eq(camera.global_position, Vector2.ZERO)
	_assert_initial_state()


func test_core_node_exit_tree_releases() -> void:
	assert_true(start())
	assert_true(CameraCore.attach_camera(camera_2d()))
	CameraCore.shake(1.0)
	run_move(Vector3(100, 0, 0), 1000)
	var node: Node = CameraCore._node
	node.get_parent().remove_child(node)
	node.free()
	assert_false(CameraCore.is_initialized())
	assert_results([FAILED])
	_assert_initial_state()
	assert_true(CameraCore.init())


func test_init_fails_without_tween_core() -> void:
	ResourceCoreDev.set_test_key_list({})
	assert_true(
		LogCore.init() and EventCore.init() and TimeCore.init() and LocalDataCore.init() and ResourceCore.init()
		and PoolCore.init() and InputBlockCore.init() and ResolutionCore.init()
	)
	assert_false(CameraCore.init())
	assert_eq(errors(), 1)
	assert_false(CameraCore.is_initialized())
	_assert_initial_state()
	assert_true(TweenCore.init())
	assert_true(CameraCore.init())


func test_operations_before_init_and_after_release_fail_with_an_error_log() -> void:
	assert_true(start(false))
	await _assert_operations_fail()
	assert_true(CameraCore.init())
	CameraCore.release()
	await _assert_operations_fail()


func _assert_operations_fail() -> void:
	var camera: Camera2D = camera_2d()
	assert_false(CameraCore.attach_camera(camera))
	CameraCore.detach_camera()
	assert_false(CameraCore.has_camera())
	assert_false(CameraCore.is_3d_camera())
	assert_false(follow(target_2d()))
	CameraCore.stop_follow()
	assert_eq(await CameraCore.move_to(Vector3.ONE, 0, LINEAR, GAME), FAILED)
	assert_eq(await CameraCore.move_by_preset(Vector3.ONE, MOVE, ResourceCore.get_global_scope()), FAILED)
	CameraCore.stop_move()
	assert_false(CameraCore.snap_to(Vector3.ONE))
	assert_eq(await CameraCore.zoom_to(2.0, 0, LINEAR, GAME), FAILED)
	assert_eq(CameraCore.get_zoom(), 1.0)
	assert_false(CameraCore.set_bounds(Rect2(0, 0, 10, 10)))
	CameraCore.clear_bounds()
	CameraCore.shake(1.0)
	CameraCore.stop_shake()
	CameraCore.set_shake_scale(500)
	CameraCoreDev.set_shake_seed(SEED)
	assert_eq(CameraCore.get_view_center(), Vector3.ZERO)
	assert_eq(CameraCore.screen_to_world(Vector2.ONE), Vector3.ZERO)
	assert_eq(CameraCore.world_to_screen(Vector3.ONE), Vector2.ZERO)
	assert_eq(errors(), 21)
	assert_eq(shake_events, 0)
	assert_eq(camera.global_position, Vector2.ZERO)


