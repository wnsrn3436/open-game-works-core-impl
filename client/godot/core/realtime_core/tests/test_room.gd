func test_token_expired_drops_the_matchmaker_lost_when_create_room_restarts_while_the_refresh_waits() -> void:
	await start_realtime()
	for refresh_ok: bool in [true, false]:
		var label: String = "refresh ok %s" % refresh_ok
		var old_op: RealtimeAsyncCall = RealtimeAsyncCall.new()
		old_op.create_room(MODE_ID)
		await frames()
		UnitTestCore.add_pending(REFRESH_TOKEN)
		push_matchmaker_lost(CoreContract.CoreError.CORE_ERROR_TOKEN_EXPIRED)
		await frames(5)
		assert_false(old_op.done, label)
		RealtimeCore.leave_room()
		await old_op.wait()
		assert_false(old_op.room_result.ok, label)
		var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
		op.create_room(MODE_ID)
		await frames()
		transport.clear_calls()
		release_refresh(refresh_ok)
		await frames(5)
		assert_eq(transport.calls.size(), 0, label + ": nothing is reopened or closed")
		assert_false(op.done, label + ": the new create_room waits")
		assert_eq(warn_logs(), 0, label)
		push_room_updated(make_room(PackedInt64Array([USER_ID])))
		await frames()
		await op.wait()
		assert_true(op.room_result.ok, label)
		assert_eq(RealtimeCore.room_info().room_code, ROOM_CODE, label)
		RealtimeCore.leave_room()
		await frames()
		events.lines.clear()
