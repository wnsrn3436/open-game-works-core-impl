func test_member_follows_the_room_match_and_open_room_cancels_it() -> void:
	await start_realtime()
	await reach_room(PackedInt64Array([OTHER_ID, USER_ID]))
	events.lines.clear()
	push_room_updated(make_room(PackedInt64Array([OTHER_ID, USER_ID]), CoreContract.RoomStatus.ROOM_STATUS_MATCHING))
	await frames()
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.MATCHING)
	assert_eq(events.count("room_match_started"), 1)
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.wait_match()
	push_match_found(make_info(2, 1))
	await frames()
	push_peer_connected(0)
	await frames()
	await op.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.SUCCESS)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.PLAYING)
	assert_eq(events.count("room_match_started"), 1)
	RealtimeCore.end_match()
	push_room_updated(make_room(PackedInt64Array([OTHER_ID, USER_ID]), CoreContract.RoomStatus.ROOM_STATUS_MATCHING))
	await frames()
	op = RealtimeAsyncCall.new()
	op.wait_match()
	push_room_updated(make_room(PackedInt64Array([OTHER_ID, USER_ID]), CoreContract.RoomStatus.ROOM_STATUS_OPEN))
	await frames()
	await op.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.CANCELLED)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.NONE)


func test_member_matching_cancels_on_an_open_room_where_it_became_the_host() -> void:
	await start_realtime()
	await reach_room(PackedInt64Array([OTHER_ID, USER_ID, THIRD_ID]))
	push_room_updated(
		make_room(PackedInt64Array([OTHER_ID, USER_ID, THIRD_ID]), CoreContract.RoomStatus.ROOM_STATUS_MATCHING)
	)
	await frames()
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.MATCHING)
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.wait_match()
	# The host left: the server sends the room back `Open` with this member first.
	push_room_updated(make_room(PackedInt64Array([USER_ID, THIRD_ID]), CoreContract.RoomStatus.ROOM_STATUS_OPEN))
	await frames()
	assert_true(op.done, "wait_match ended")
	await op.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.CANCELLED)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.NONE)
	assert_eq(RealtimeCore.room_info().members, PackedInt64Array([USER_ID, THIRD_ID]))
	transport.clear_calls()
	var started: RealtimeAsyncCall = RealtimeAsyncCall.new()
	started.start_room()
	await frames()
	assert_eq(transport.count("start_room"), 1, "the new host starts the room")


func test_host_join_match_cancels_on_an_open_room_after_a_member_left() -> void:
	await start_realtime()
	await reach_room(PackedInt64Array([USER_ID, OTHER_ID]))
	transport.clear_calls()
	events.lines.clear()
	var op: RealtimeAsyncCall = await start_join()
	var waiting: RealtimeAsyncCall = RealtimeAsyncCall.new()
	waiting.wait_match()
	push_room_updated(make_room(PackedInt64Array([USER_ID, OTHER_ID]), CoreContract.RoomStatus.ROOM_STATUS_MATCHING))
	await frames()
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.MATCHING)
	assert_false(op.done, "join_match waits for the match")
	# The member left: the server took the party out of the queue, so no match found or match failed follows.
	push_room_updated(make_room(PackedInt64Array([USER_ID]), CoreContract.RoomStatus.ROOM_STATUS_OPEN))
	await frames()
	assert_true(op.done, "join_match ended")
	assert_true(waiting.done, "wait_match ended")
	await op.wait()
	await waiting.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.CANCELLED)
	assert_eq(op.join_result.error_code, 0)
	assert_eq(waiting.join_result.status, RealtimeCore.MatchJoinStatus.CANCELLED)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.NONE)
	assert_eq(RealtimeCore.room_info().members, PackedInt64Array([USER_ID]))
	assert_eq(transport.count("cancel_matching"), 0)
	assert_eq(transport.count("close"), 0)
	assert_eq(events.count("room_match_started"), 0)
	assert_eq(warn_logs(), 0)
	# The room stays, and the next `join_match` of the host is taken.
	transport.clear_calls()
	var next: RealtimeAsyncCall = await start_join()
	assert_eq(transport.count("start_matching"), 1)
	assert_false(next.done, "the next join_match waits for the match")
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.MATCHING)


