	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(op.join_result.error_code, CoreContract.CoreError.CORE_ERROR_ROOM_NOT_ENOUGH_PLAYERS)
	assert_eq(warn_logs(), 1)


