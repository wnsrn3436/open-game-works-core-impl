	await op.wait()
	assert_false(op.room_result.ok)
	assert_eq(op.room_result.error_code, CoreContract.CoreError.CORE_ERROR_BANNED)
	assert_eq(warn_logs(), 1)
	await reach_room(PackedInt64Array([USER_ID, OTHER_ID]))
	events.lines.clear()
	op = RealtimeAsyncCall.new()
	op.start_room()
	await frames()
	push_matchmaker_lost(CoreContract.CoreError.CORE_ERROR_MAINTENANCE)
	await frames()
	await op.wait()
	assert_eq(RealtimeCore.room_info().room_code, "")
	assert_eq(events.lines, PackedStringArray(["room:LOST"]))
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(op.join_result.error_code, CoreContract.CoreError.CORE_ERROR_MAINTENANCE)
	assert_eq(warn_logs(), 2)


func test_room_stays_after_the_match_and_leave_room_leaves_it_once() -> void:
	await start_realtime()
	await reach_room(PackedInt64Array([USER_ID, OTHER_ID]))
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.start_room()
	await frames()
	push_match_found(make_info())
	await frames()
	push_peer_connected(1)
	await frames()
	await op.wait()
	RealtimeCore.end_match()
	await frames()
	assert_eq(RealtimeCore.room_info().room_code, ROOM_CODE)
	assert_eq(transport.count("leave_room"), 0)
	events.lines.clear()
	RealtimeCore.leave_room()
	assert_eq(transport.count("leave_room"), 1)
	assert_eq(events.lines, PackedStringArray(["room:LEFT"]))
	assert_eq(RealtimeCore.room_info().room_code, "")
	RealtimeCore.leave_room()
	assert_eq(warn_logs(), 1)
	assert_eq(transport.count("leave_room"), 1)


