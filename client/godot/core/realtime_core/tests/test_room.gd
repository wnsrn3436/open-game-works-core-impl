func test_matchmaker_lost_fails_a_waiting_create_room_and_a_waiting_start_room() -> void:
	await start_realtime()
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.create_room(MODE_ID)
	await frames()
	push_matchmaker_lost(CoreContract.CoreError.CORE_ERROR_BANNED)
