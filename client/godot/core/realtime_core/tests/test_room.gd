extends RealtimeTestCase
## Rooms: create and join, room failed routing, the host and the non-host member matches, kick, leave and release.


func test_create_room_opens_the_room_and_takes_the_first_room_updated() -> void:
	await start_realtime()
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.create_room(MODE_ID)
	await frames()
	assert_eq(transport.calls, PackedStringArray(["open_room(%d, , %s, false)" % [MODE_ID, ACCESS_TOKEN]]))
	push_room_updated(make_room(PackedInt64Array([USER_ID])))
	await frames()
	await op.wait()
	assert_true(op.room_result.ok)
	assert_eq(op.room_result.error_code, 0)
	assert_eq(RealtimeCore.room_info().room_code, ROOM_CODE)
	assert_eq(RealtimeCore.room_info().members, PackedInt64Array([USER_ID]))
	assert_eq(events.lines, PackedStringArray(["room:UPDATED"]))


func test_open_room_failed_first_fails_create_room_with_its_code() -> void:
	await start_realtime()
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.join_room(ROOM_CODE)
	await frames()
	assert_eq(transport.calls, PackedStringArray(["open_room(0, %s, %s, false)" % [ROOM_CODE, ACCESS_TOKEN]]))
	push_room_failed(CoreContract.CoreError.CORE_ERROR_ROOM_FULL, RealtimeCore.RoomRequest.OPEN)
	await frames()
	await op.wait()
	assert_false(op.room_result.ok)
	assert_eq(op.room_result.error_code, CoreContract.CoreError.CORE_ERROR_ROOM_FULL)
	assert_eq(RealtimeCore.room_info().room_code, "")
	assert_eq(warn_logs(), 1)


func test_create_room_and_join_room_without_an_access_token_fail_with_a_warning() -> void:
	await start_realtime()
	await lose_access_token()
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.create_room(MODE_ID)
	await frames(5)
	assert_true(op.done, "create_room ended")
	await op.wait()
	assert_false(op.room_result.ok)
	assert_eq(op.room_result.error_code, 0)
	# The access token is still expired: the next call refreshes again.
	add_error(REFRESH_TOKEN, CoreContract.CoreError.CORE_ERROR_MAINTENANCE)
	op = RealtimeAsyncCall.new()
	op.join_room(ROOM_CODE)
	await frames(5)
	assert_true(op.done, "join_room ended")
	await op.wait()
	assert_false(op.room_result.ok)
	assert_eq(op.room_result.error_code, 0)
	assert_eq(transport.calls.size(), 0)
	assert_eq(RealtimeCore.room_info().room_code, "")
	assert_eq(events.lines.size(), 0)
	assert_eq(warn_logs(), 2)
	# Without a waiting operation, the next create_room is taken.
	add_refresh_result()
	op = RealtimeAsyncCall.new()
	op.create_room(MODE_ID)
	await frames(5)
	assert_eq(transport.calls, PackedStringArray(["open_room(%d, , %s, false)" % [MODE_ID, NEW_ACCESS_TOKEN]]))


func test_create_and_join_room_in_a_room_or_outside_none_fail_at_once() -> void:
	await start_realtime()
	await reach_room(PackedInt64Array([USER_ID]))
	transport.clear_calls()
	var result: RoomResult = await RealtimeCore.create_room(MODE_ID)
	assert_false(result.ok)
	result = await RealtimeCore.join_room(ROOM_CODE)
	assert_false(result.ok)
	assert_eq(warn_logs(), 2)
	assert_eq(transport.calls.size(), 0)
	RealtimeCore.leave_room()
	var join: RealtimeAsyncCall = await start_join()
	transport.clear_calls()
	result = await RealtimeCore.create_room(MODE_ID)
	assert_false(result.ok)
	result = await RealtimeCore.join_room(ROOM_CODE)
	assert_false(result.ok)
	assert_eq(warn_logs(), 2)
	assert_eq(transport.calls.size(), 0)
	RealtimeCore.leave()
	await join.wait()


func test_while_create_room_waits_other_room_and_match_operations_fail_and_leave_room_cancels_it() -> void:
	await start_realtime()
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.create_room(MODE_ID)
	await frames()
	transport.clear_calls()
	assert_false((await RealtimeCore.create_room(MODE_ID)).ok)
	assert_false((await RealtimeCore.join_room(ROOM_CODE)).ok)
	assert_eq((await RealtimeCore.join_match(MODE_ID)).status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(warn_logs(), 3)
	assert_eq(transport.calls.size(), 0)
	RealtimeCore.leave_room()
	await op.wait()
	assert_eq(transport.calls, PackedStringArray(["leave_room()"]))
	assert_false(op.room_result.ok)
	assert_eq(op.room_result.error_code, 0)
	assert_eq(events.count("room"), 0)
	push_room_updated(make_room(PackedInt64Array([USER_ID])))
	push_room_kicked()
	await frames()
	assert_eq(warn_logs(), 0)
	assert_eq(RealtimeCore.room_info().room_code, "")
	assert_eq(events.count("room"), 0)


