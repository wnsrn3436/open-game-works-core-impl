extends RealtimeTestCase
## `release` in a match, the saved `MatchInfo`, `rejoin_match` and the left list of rejoined.


func test_release_in_playing_disconnects_without_close_or_events_and_init_starts_in_none() -> void:
	await start_realtime()
	await reach_playing()
	transport.clear_calls()
	var lines: int = events.lines.size()
	RealtimeCore.release()
	assert_eq(transport.calls, PackedStringArray(["disconnect()"]))
	assert_eq(events.lines.size(), lines)
	assert_true(RealtimeCore.init())
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.NONE)


func test_match_info_is_saved_in_connecting_and_removed_when_the_match_goes_none() -> void:
	await start_realtime()
	await reach_playing()
	assert_eq(saved_id(), MATCH_ID)
	RealtimeCore.end_match()
	assert_eq(saved_id(), "")
	var op: RealtimeAsyncCall = await start_join()
	push_match_found(make_info())
	await frames()
	assert_eq(saved_id(), MATCH_ID)
	RealtimeCore.leave()
	await op.wait()
	assert_eq(saved_id(), "")
	op = await start_join()
	push_match_found(make_info())
	await frames()
	assert_eq(saved_id(), MATCH_ID)
	push_matchmaker_lost(0)
	await frames()
	await op.wait()
	assert_eq(saved_id(), "")
	assert_eq(warn_logs(), 1)
	op = await start_join()
	push_match_found(make_info())
	await frames()
	RealtimeCore.release()
	assert_eq(saved_id(), MATCH_ID)
	assert_eq(RealtimeCore.saved_match_id(), "")
	assert_eq(error_logs(), 1)


func test_rejoin_match_after_release_and_init_rejoins_the_saved_match() -> void:
	await start_realtime()
	var info: MatchInfo = make_info(2, 1)
	var op: RealtimeAsyncCall = await start_join()
	push_match_found(info)
	await frames()
	RealtimeCore.release()
	await op.wait()
	RealtimeCore.set_transport(transport)
	assert_true(RealtimeCore.init())
	transport.clear_calls()
	assert_eq(RealtimeCore.saved_match_id(), MATCH_ID)
	op = RealtimeAsyncCall.new()
	op.rejoin_match(RealtimeCore.saved_match_id())
	await frames()
	assert_eq(transport.calls, PackedStringArray(["rejoin(%s, %s)" % [MATCH_ID, ACCESS_TOKEN]]))
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.CONNECTING)
	push_rejoined(true)
	await frames()
	assert_eq(transport.count("connect_peer"), 1)
	push_peer_connected(0)
	await frames()
	await op.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.SUCCESS)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.PLAYING)
	var got: MatchInfo = RealtimeCore.match_info()
	assert_eq(got.match_id, info.match_id)
	assert_eq(got.mode_id, info.mode_id)
	assert_eq(got.my_index, info.my_index)
	assert_eq(got.user_ids, info.user_ids)
	assert_eq(got.teams, info.teams)
	assert_eq(got.parties, info.parties)
	assert_eq(got.match_seed, info.match_seed)
	assert_eq(got.start_at, info.start_at)
	assert_eq(got.lockstep, info.lockstep)


func test_rejoin_match_without_a_transport_fails_with_an_error_and_stays_none() -> void:
	await start_realtime(false)
	var result: MatchJoinResult = await RealtimeCore.rejoin_match(MATCH_ID)
	assert_eq(result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(error_logs(), 1)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.NONE)
	assert_eq(transport.calls.size(), 0)


func test_rejoined_failure_fails_and_removes_the_saved_match_info() -> void:
	await start_realtime()
	await _save_match(make_info())
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.rejoin_match(MATCH_ID)
	await frames()
	push_rejoined(false)
	await frames()
	await op.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.NONE)
	assert_eq(saved_id(), "")
	assert_eq(transport.count("close"), 1)
	assert_eq(warn_logs(), 1)


func test_rejoin_match_without_an_access_token_closes_goes_none_and_fails_with_a_warning() -> void:
	await start_realtime()
	await _save_match(make_info())
	transport.clear_calls()
	await lose_access_token()
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.rejoin_match(MATCH_ID)
	await frames(5)
	assert_true(op.done, "rejoin_match ended")
	await op.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.NONE)
	assert_eq(saved_id(), "")
	assert_eq(transport.calls, PackedStringArray(["close()"]))
	assert_eq(warn_logs(), 1)
	assert_eq(error_logs(), 0)


func test_saved_match_info_failing_the_check_fails_and_is_removed() -> void:
	await start_realtime()
	for count_change: int in PackedInt32Array([-1, 1]):
		for field: int in 2:
			var info: MatchInfo = make_info()
			if field == 0:
				info.teams.resize(info.teams.size() + count_change)
			else:
				info.parties.resize(info.parties.size() + count_change)
			await _save_match(info)
			transport.clear_calls()
			var result: MatchJoinResult = await RealtimeCore.rejoin_match(MATCH_ID)
			assert_eq(result.status, RealtimeCore.MatchJoinStatus.FAILED)
			assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.NONE)
			assert_eq(saved_id(), "")
			assert_eq(error_logs(), 1)
			assert_eq(transport.calls.size(), 0)


func test_rejoin_match_outside_none_in_a_room_or_with_another_id_fails_at_once() -> void:
	await start_realtime()
	await _save_match(make_info())
	transport.clear_calls()
	var result: MatchJoinResult = await RealtimeCore.rejoin_match("match-other")
	assert_eq(result.status, RealtimeCore.MatchJoinStatus.FAILED)
	result = await RealtimeCore.rejoin_match("")
	assert_eq(result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(warn_logs(), 2)
	assert_eq(transport.calls.size(), 0)
	var create: RealtimeAsyncCall = RealtimeAsyncCall.new()
	create.create_room(MODE_ID)
	await frames()
	transport.clear_calls()
	result = await RealtimeCore.rejoin_match(MATCH_ID)
	assert_eq(result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(warn_logs(), 1)
	assert_eq(transport.calls.size(), 0)
	push_room_updated(make_room(PackedInt64Array([USER_ID])))
	await frames()
	await create.wait()
	transport.clear_calls()
	result = await RealtimeCore.rejoin_match(MATCH_ID)
	assert_eq(result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(warn_logs(), 1)
	assert_eq(transport.calls.size(), 0)
	assert_eq(RealtimeCore.room_info().room_code, ROOM_CODE)
	var join: RealtimeAsyncCall = await start_join()
	transport.clear_calls()
	result = await RealtimeCore.rejoin_match(MATCH_ID)
	assert_eq(result.status, RealtimeCore.MatchJoinStatus.FAILED)
	assert_eq(warn_logs(), 1)
	assert_eq(transport.calls.size(), 0)
	assert_eq(RealtimeCore.room_info().room_code, ROOM_CODE)
	RealtimeCore.leave()
	await join.wait()


func test_rejoined_left_list_leaves_without_events_and_connects_only_the_others() -> void:
	await start_realtime()
	await _save_match(make_info(3, 0))
	transport.clear_calls()
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.rejoin_match(MATCH_ID)
	await frames()
	push_rejoined(true, PackedInt32Array([2]))
	await frames()
	assert_eq(RealtimeCore.peer_state(2), RealtimeCore.PeerState.LEFT)
	assert_has(transport.calls, "close_peer(2)")
	assert_eq(transport.count("connect_peer"), 1)
	assert_has(transport.calls, "connect_peer(1)")
	assert_eq(events.count("left"), 0)
	push_peer_connected(1)
	await frames()
	await op.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.SUCCESS)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.PLAYING)


func test_rejoined_with_every_other_left_plays_at_once() -> void:
	await start_realtime()
	await _save_match(make_info(2, 0))
	var op: RealtimeAsyncCall = RealtimeAsyncCall.new()
	op.rejoin_match(MATCH_ID)
	await frames()
	push_rejoined(true, PackedInt32Array([1]))
	await frames()
	await op.wait()
	assert_eq(op.join_result.status, RealtimeCore.MatchJoinStatus.SUCCESS)
	assert_eq(RealtimeCore.match_state(), RealtimeCore.MatchState.PLAYING)


func test_in_match_rejoin_left_list_leaves_disconnected_participants_once() -> void:
	await start_realtime()
	await reach_playing(4, 0)
	push_peer_lost(1)
	push_leave_notice(3, 1)
	await frames()
	events.lines.clear()
	push_matchmaker_lost(0)
	await frames()
	assert_eq(transport.count("rejoin"), 1)
	push_rejoined(true, PackedInt32Array([1, 3]))
	await frames()
	assert_eq(RealtimeCore.peer_state(1), RealtimeCore.PeerState.LEFT)
	assert_eq(RealtimeCore.peer_state(2), RealtimeCore.PeerState.CONNECTED)
	assert_eq(events.lines, PackedStringArray(["left:1:LEFT"]))
	assert_eq(warn_logs(), 1)


## Saves `info` the way `Connecting` does: joins a match with it, then releases and initializes RealtimeCore again.
func _save_match(info: MatchInfo) -> void:
	var op: RealtimeAsyncCall = await start_join()
	push_match_found(info)
	await frames()
	if RealtimeCore.match_state() == RealtimeCore.MatchState.NONE:
		# A MatchInfo that fails the check is written straight to the user file.
		error_logs()
		warn_logs()
		_write_saved(info)
	RealtimeCore.release()
	await op.wait()
	RealtimeCore.set_transport(transport)
	assert_true(RealtimeCore.init())


func _write_saved(info: MatchInfo) -> void:
	var kind: LocalDataCore.FileKind = LocalDataCore.FileKind.USER
	LocalDataCore.set_value_string(kind, "RealtimeCore.match_id", info.match_id)
	LocalDataCore.set_value_int(kind, "RealtimeCore.mode_id", info.mode_id)
	LocalDataCore.set_value_int(kind, "RealtimeCore.my_index", info.my_index)
	LocalDataCore.set_array_int(kind, "RealtimeCore.players", info.user_ids)
	LocalDataCore.set_array_int(kind, "RealtimeCore.teams", info.teams)
	LocalDataCore.set_array_int(kind, "RealtimeCore.parties", info.parties)
	LocalDataCore.set_value_bool(kind, "RealtimeCore.lockstep", info.lockstep)
	LocalDataCore.set_value_int(kind, "RealtimeCore.seed", info.match_seed)
	LocalDataCore.set_value_int(kind, "RealtimeCore.start_at", info.start_at)
