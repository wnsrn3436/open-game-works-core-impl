#!/usr/bin/env python
# macOS GDExtension library of `ogw-native-ui`. Run from this folder:
#   scons platform=macos target=template_release godot_cpp=<godot-cpp checkout>
# The library goes to `bin/libogw-native-ui.macos.dylib`.
import os

godot_cpp = ARGUMENTS.pop("godot_cpp", os.environ.get("GODOT_CPP_DIR", ""))
# `<from>=<to>` pairs joined by ";" for -ffile-prefix-map, so the library does not hold the build folders of the host
file_prefix_maps = ARGUMENTS.pop("file_prefix_maps", "")
if godot_cpp == "":
    raise SystemExit("godot_cpp=<godot-cpp checkout> is required")
ARGUMENTS.setdefault("api_version", "4.7")
# Lowest macOS of the Godot macOS export defaults (4.7.2: `application/min_macos_version_x86_64` 11.00,
# `application/min_macos_version_arm64` 13.00), for both slices. Without it the library takes the macOS of the build host.
ARGUMENTS.setdefault("macos_deployment_target", "11.0")
env = SConscript(os.path.join(godot_cpp, "SConstruct"))
env.Append(CPPPATH=["src"])
env.Append(CCFLAGS=["-fobjc-arc"])
env.Append(CCFLAGS=["-ffile-prefix-map=" + m for m in file_prefix_maps.split(";") if m != ""])
env.Append(LINKFLAGS=["-framework", "AppKit", "-framework", "StoreKit", "-framework", "Foundation"])

sources = Glob("src/*.mm")
if env["platform"] != "macos":
    raise SystemExit("this library is for platform=macos")
library = env.SharedLibrary(
    "bin/libogw-native-ui.macos.dylib",
    source=sources,
)
Default(library)
