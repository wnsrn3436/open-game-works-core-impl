{
  "engine": "godot",
  "coreVersion": "0.0.0",
  "coreModules": {
    "client": [],
    "server": []
  },
  "core": {
    "UnitTestCore.testTimeLimitMs": 30000
  },
  "appId": "com.example.coretest",
  "sourceLanguage": "en",
  "supportedLanguages": [
    "en",
    "zh-Hans",
    "zh-TW",
    "ca"
  ],
  "environments": {
    "DEV": {
      "serverUrl": "https://dev.example.com",
      "corsAllowedOrigins": [],
      "trustedProxyCount": 1,
      "adminOperators": [
        {
          "name": "ogw",
          "roles": [
            "read",
            "ops",
            "release"
          ],
          "secret": "admin-ogw-dev"
        }
      ],
      "secrets": {
        "db": "db-dev",
        "accessTokenKey": "atk-dev",
        "updateSigningKey": "usk-dev",
        "devAccess": "dev-access",
        "deploySsh": "ssh-dev",
        "dbPassword": "dbpw-dev"
      },
      "adapters": {
        "iap-apple": "fake",
        "iap-google": "fake"
      },
      "deploy": {
        "host": "dev.example.com",
        "hostKey": "ssh-ed25519 AAAAC3Nza",
        "user": "deploy",
        "dir": "/srv/dev",
        "port": 8080
      }
    },
    "STG": {
      "serverUrl": "https://stg.example.com",
      "corsAllowedOrigins": [],
      "trustedProxyCount": 1,
      "adminOperators": [
        {
          "name": "ogw",
          "roles": [
            "read",
            "ops",
            "release"
          ],
          "secret": "admin-ogw-stg"
        }
      ],
      "secrets": {
        "db": "db-stg",
        "accessTokenKey": "atk-stg",
        "updateSigningKey": "usk-stg",
        "deploySsh": "ssh-stg",
        "dbPassword": "dbpw-stg"
      },
      "adapters": {},
      "deploy": {
        "host": "stg.example.com",
        "hostKey": "ssh-ed25519 AAAAC3Nza",
        "user": "deploy",
        "dir": "/srv/stg",
        "port": 8080
      }
    },
    "PROD": {
      "serverUrl": "https://prod.example.com",
      "corsAllowedOrigins": [],
      "trustedProxyCount": 1,
      "adminOperators": [
        {
          "name": "ogw",
          "roles": [
            "read"
          ],
          "secret": "admin-ogw-prod"
        }
      ],
      "secrets": {
        "db": "db-prod",
        "accessTokenKey": "atk-prod",
        "updateSigningKey": "usk-prod",
        "cdn": "cdn-prod"
      },
      "adapters": {
        "cdn": "cdn-r2"
      },
      "cdnR2": {
        "accountId": "acc",
        "bucket": "bucket",
        "accessKeyId": "key",
        "publicBaseUrl": "https://cdn.example.com/game"
      }
    }
  },
  "buildPlatforms": [
    "linux"
  ],
  "serverImage": {
    "repository": "ghcr.io/example/coretest-server"
  },
  "postgresqlMajor": 18,
  "baseResolution": [
    1280,
    720
  ],
  "maxResolution": [
    1920,
    1080
  ],
  "uiCheckScreens": [
    {
      "name": "desktop",
      "window": [
        1280,
        720
      ],
      "fillMode": "Letterbox",
      "notch": [
        0,
        0,
        0,
        0
      ]
    }
  ],
  "titleScene": "scene_title",
  "firstScene": "scene_lobby",
  "loadingScreen": "prefab_loading",
  "termsPopup": "prefab_terms",
  "termsDocuments": {
    "TERMS": {
      "version": 1,
      "url": "https://example.com/terms"
    },
    "PRIVACY": {
      "version": 1,
      "url": "https://example.com/privacy"
    }
  },
  "nicknameUnique": true,
  "consent": {
    "ageConfirmation": false,
    "privacyChoices": false,
    "version": 1,
    "trackingRequest": false,
    "ageBandBoundaries": [
      13,
      14,
      16,
      18,
      19
    ]
  },
  "pushConsent": {
    "adPush": true,
    "nightStartMinute": 1320,
    "nightEndMinute": 480
  }
}
