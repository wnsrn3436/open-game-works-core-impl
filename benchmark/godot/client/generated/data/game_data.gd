static func _read_ad_placement_row(bytes: PackedByteArray) -> AdPlacementRow:
	var row: AdPlacementRow = AdPlacementRow.new()
	var r: ContractMessage._WireReader = ContractMessage._WireReader.new(bytes)
	while r.more():
		var tag: int = r.tag()
		var wire: int = tag & 7
		match tag >> 3:
			1:
				row.id = r.int32(wire)
			2:
				row.type = r.int32(wire) as AdType
			3:
				var amount: CoreContract.ItemAmount = CoreContract.ItemAmount.new()
				if not amount.decode(r.bytes(wire)):
					_failed = true
				row.reward.append(amount)
			4:
				row.extra_grant = r.boolean(wire)
			5:
				row.limit_count = r.int32(wire)
			6:
				row.reset = r.int32(wire) as ResetCycle
			7:
				row.min_interval = r.int64(wire)
			8:
				row.first_show_after = r.int64(wire)
			9:
				row.every_n = r.int32(wire)
			10:
				row.suppress_if_product.append_array(r.int32_list(wire))
			_:
				r.skip(wire)
	if r.failed:
		_failed = true
	return row


static func _read_ad_placement_rows(bytes: PackedByteArray) -> Array[AdPlacementRow]:
	var rows: Array[AdPlacementRow] = []
	var r: ContractMessage._WireReader = ContractMessage._WireReader.new(bytes)
	while r.more():
		var tag: int = r.tag()
		var wire: int = tag & 7
		match tag >> 3:
			1:
				rows.append(_read_ad_placement_row(r.bytes(wire)))
			_:
				r.skip(wire)
	if r.failed:
		_failed = true
	return rows


